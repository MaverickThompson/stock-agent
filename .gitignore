# Market data. ~500 CSVs of licensed price history, and none of it is mine to
# redistribute. `python scripts/fetch_data.py` rebuilds this directory.
data/

# Reference PDFs live one level up in `reference/` and are copyrighted
# textbooks. Cited in the README, never shipped.

# Backtest output.
out_*.csv
logs/

# Python build artifacts.
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/

# Coverage output (reported to Codecov, never committed).
.coverage
.coverage.*
coverage.xml
htmlcov/

# JetBrains. PyCharm rewrites these constantly; shared run configs live in
# `.run/` instead, which IS committed.
.idea/
*.iml

# Earnings calendar is a 24h CACHE, not a study log. Section 10 defines exactly
# two logs -- signals.csv and trades.csv -- and a 4,200-line calendar recommitted
# every session would bury them in the history.
study/earnings_calendar.csv
